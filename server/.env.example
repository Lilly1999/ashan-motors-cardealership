# Copy this file to .env and adjust the values. (.env is never committed to git.)

# PostgreSQL connection. Remove or leave empty to store data in data/inventory.json instead.
DATABASE_URL=postgres://ashan:ashan-dev-password@localhost:5432/ashan_motors
# Set to true for hosted databases that require SSL (automatic when the URL contains sslmode=require).
DATABASE_SSL=false

# Admin sign-in password (required in production).
ADMIN_PASSWORD=change-me
# Any long random text; used to sign admin sign-in tokens.
SESSION_SECRET=change-me-to-a-long-random-string

# Only needed if the website and API are hosted on different domains.
CLIENT_ORIGIN=http://localhost:4200

PORT=3000
